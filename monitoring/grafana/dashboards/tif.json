      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "max(increase(etcd_server_leader_changes_seen_total{job=\"etcd\"}[1h]))",
          "legendFormat": "cambios",
          "range": true
