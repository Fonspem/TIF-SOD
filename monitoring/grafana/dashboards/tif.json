{
  "uid": "tif-estado",
  "title": "TIF · Estado del sistema",
  "tags": [
    "tif"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Estado de los nodos y del líder",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Nodos arriba: VM, etcd y MinIO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tif"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "up{job=\"nodos\"}",
          "legendFormat": "{{vm}} · VM",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "up{job=\"etcd\"}",
          "legendFormat": "{{vm}} · etcd",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "up{job=\"minio-nodo\"}",
          "legendFormat": "{{vm}} · MinIO",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Arriba",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Caído",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Si Prometheus puede leer las métricas de cada componente. Caído = no responde."
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Líder actual de etcd",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tif"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "etcd_server_is_leader{job=\"etcd\"}",
          "legendFormat": "{{vm}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Líder",
                  "color": "blue",
                  "index": 0
                },
                "0": {
                  "text": "Seguidor",
                  "color": "#c3c2b7",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Qué miembro es el líder en cada momento. Un hueco es un miembro que no responde."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "etcd: miembros con líder",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tif"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tif"
          },
          "expr": "sum(etcd_server_has_leader{job=\"etcd\"})",
          "legendFormat": "de 3",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "value_and_name"
      },
      "description": "Cuántos miembros de etcd ven un líder. Con menos de 2 no hay quórum."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "etcd: cambios de líder (1 h)",
